---
import { Image } from 'astro:assets';
import logoDark from '../assets/logo-dark.png';
import logoLight from '../assets/logo-light.png';
import { nav } from '../data/empresa';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCur = (href: string) => !href.startsWith('/#') && path === href;
---
<header class="site-header">
  <div class="wrap">
    <a class="brand" href="/" aria-label="Next AI, início">
      <Image class="logo-dark" src={logoDark} alt="Next AI Engenharia & Automação" height={88} loading="eager" />
      <Image class="logo-light" src={logoLight} alt="" aria-hidden="true" height={88} loading="eager" />
    </a>
    <nav class="nav" id="nav" aria-label="Principal">
      {nav.map((n) => <a href={n.href} class={isCur(n.href) ? 'cur' : undefined} aria-current={isCur(n.href) ? 'page' : undefined}>{n.label}</a>)}
    </nav>
    <div class="hbar">
      <a class="btn btn-sm btn-amber" href="/#contato">Fale conosco</a>
      <button id="theme" class="theme-btn" type="button" aria-label="Mudar para tema claro" title="Alternar tema">
        <svg class="i-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        <svg class="i-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
      </button>
      <button id="menu" class="menu-btn" type="button" aria-expanded="false" aria-controls="nav">Menu</button>
    </div>
  </div>
</header>
<style is:global>
  .brand .logo-light { display: none; }
  :root[data-deck='light'] .brand .logo-dark { display: none; }
  :root[data-deck='light'] .brand .logo-light { display: block; }
</style>
